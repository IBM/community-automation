kdb=ihsserverkey.kdb
ihshost=`hostname`
rm -f ${kdb} ihsserverkey.rdb ihsserverkey.crl ihsserverkey.sth

export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:{{ install_ihs_base }}/{{ http_dir }}/gsk8/lib64
export PATH={{ install_ihs_base }}/{{ http_dir }}/gsk8/bin/:$PATH
echo "Creating $kdb"
gsk8capicmd_64 -keydb -create -db ${kdb} -type cms -pw '{{ certPw }}' -stash -expire 7300
echo "Creating certificates"
gsk8capicmd_64 -cert -create -db ${kdb} -type cms -label ihs -pw '{{ certPw }}' -DN CN=$ihshost -size 2048 -default_cert yes -expire 7300
gsk8capicmd_64 -cert -details -label "ihs" -db ${kdb} -pw '{{ certPw }}'
echo "Completed creating ldap certificates"
gsk8capicmd_64 -cert -list -db ${kdb} -pw '{{ certPw }}'
gsk8capicmd_64 -cert -extract -db ${kdb} -type cms -label ihs -pw '{{ certPw }}' -target $ihshost.base64.cert
